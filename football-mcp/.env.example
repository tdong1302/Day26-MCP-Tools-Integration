# Get a free token from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=replace_with_your_football_data_token

# Local bearer token chosen by you. Use a long random value outside a lab.
MCP_AUTH_TOKEN=replace_with_your_local_mcp_token

# OpenAI API key with active API credit/billing (ChatGPT access is separate).
OPENAI_API_KEY=replace_with_your_openai_api_key

PORT=8086

